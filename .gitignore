# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Data (large, reproducible from source — never commit raw/processed datasets)
data/raw/**
data/processed/**
data/cache/**
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep

# Reports (generated artifacts can be large; keep only curated ones under reports/ if explicitly added)
reports/generated/

# Secrets — never commit API keys
.env
*.env
secrets.yaml
secrets.yml

# OS / editor
.DS_Store
.idea/
.vscode/
